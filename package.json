{
  "name": "champion-soundboard",
  "version": "1.2.0",
  "description": "LBGM - League of Legends champion music soundboard (local only)",
  "main": "main.js",
  "author": "LBGM contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "test:renderer": "electron tests/renderer-smoke.cjs",
    "test:internal": "electron tests/internal-audio-smoke.cjs",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@39.8.10": true
  },
  "build": {
    "appId": "com.lbgm.soundboard",
    "productName": "LBGM",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**"
    ],
    "asarUnpack": [
      "renderer/icon.png"
    ],
    "extraResources": [
      "scripts/ensure-shortcut.ps1",
      "scripts/GameHotkeyStateHelperV2.exe"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/app.ico",
      "requestedExecutionLevel": "highestAvailable"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "artifactName": "LBGM-Setup-${version}.${ext}"
    }
  }
}
